{
  "name": "family-os",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @family-os/api --filter @family-os/web dev",
    "dev:api": "pnpm --filter @family-os/api dev",
    "dev:web": "pnpm --filter @family-os/web dev",
    "build": "pnpm --filter @family-os/api build && pnpm --filter @family-os/api-client build && pnpm --filter @family-os/web build",
    "test": "pnpm --filter @family-os/api test",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "openapi:export": "pnpm --filter @family-os/api openapi:export",
    "openapi:generate": "pnpm --filter @family-os/api-client generate"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}

# API
API_PORT=3001
API_HOST=0.0.0.0
DATA_DIR=./data
COOKIE_SECURE=false
SESSION_TTL_DAYS=30
BOOTSTRAP_ADMIN_USERNAME=admin
# 仅供本地开发；production 首次建库或修复旧默认账号时必须替换为至少 12 位非默认密码。
BOOTSTRAP_ADMIN_PASSWORD=changeme
BOOTSTRAP_ADMIN_PERSON_NAME=管理员
BOOTSTRAP_HOUSEHOLD_NAME=默认家庭
PUBLIC_ORIGIN=http://127.0.0.1:3000

# Docker Compose 默认只监听本机；家庭局域网访问需显式改为 0.0.0.0，并同时配置强凭据与防火墙。
COMPOSE_BIND_ADDRESS=127.0.0.1

# Agent（首期仅 DeepSeek）。密钥请写到 .env.local，不要提交。
# 加载顺序：已有进程环境 > ENV_FILE > .env.local > .env
# 空字符串视为已设置，不会被文件覆盖。Docker 另见 docs/architecture/deployment.md
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
AGENT_MODEL_TIMEOUT_MS=60000
AGENT_MODEL_RETRIES=1

# Web
NEXT_PUBLIC_API_BASE_URL=/api/v1
INTERNAL_API_BASE_URL=http://127.0.0.1:3001/api/v1
